# PostgreSQL
POSTGRES_USER=artifactlog
POSTGRES_PASSWORD=artifactlog
POSTGRES_DB=artifactlog
# Host port published for the database (remove to keep it internal)
POSTGRES_PORT=5432

# API host port
API_PORT=8080

# Optional: pin the initial Ed25519 signing key.
# Leave empty to let the service generate one on first boot (the public key
# is then available at GET /v1/keys). SIGNING_PRIVATE_KEY is the 32-byte
# Ed25519 seed, base64-encoded.
SIGNING_KEY_ID=
SIGNING_PRIVATE_KEY=
